@model List<MedicalConnect.ViewModels.DoctorApprovalViewModel>
@{
    ViewData["Title"] = "طلبات الأطباء المعلقة";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container mt-4">
    <h2 class="mb-3">
        <i class="fas fa-user-clock text-warning me-2"></i>
        طلبات الأطباء المعلقة
    </h2>

    @if (Model.Any())
    {
        <div class="table-responsive">
            <table class="table table-bordered table-hover">
                <thead class="table-light">
                    <tr>
                        <th>الصورة</th>
                        <th>الاسم</th>
                        <th>التخصص</th>
                        <th>سنوات الخبرة</th>
                        <th>البريد</th>
                        <th>الهاتف</th>
                        <th>الإجراءات</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var doctor in Model)
                    {
                        <tr>
                            <td>
                                <img src="@doctor.ImageUrl"
                                     alt="@doctor.FullName"
                                     class="rounded-circle"
                                     width="40"
                                     height="40" />
                            </td>
                            <td>@doctor.FullName</td>
                            <td>@doctor.Specialization</td>
                            <td>@doctor.ExperienceYears سنة</td>
                            <td>@doctor.Email</td>
                            <td>@doctor.PhoneNumber</td>
                            <td>
                                <div class="btn-group btn-group-sm">
                                    <form asp-action="ApproveDoctorRegistration" method="post" class="d-inline">
                                        <input type="hidden" name="userId" value="@doctor.UserId" />
                                        <button type="submit" class="btn btn-success">
                                            <i class="fas fa-check"></i>
                                        </button>
                                    </form>
                                    <form asp-action="RejectDoctorRegistration" method="post" class="d-inline">
                                        <input type="hidden" name="userId" value="@doctor.UserId" />
                                        <button type="submit" class="btn btn-danger">
                                            <i class="fas fa-times"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="text-center py-4">
            <i class="fas fa-check-circle text-success fa-3x mb-3"></i>
            <p class="text-muted">لا توجد طلبات معلقة</p>
        </div>
    }
</div>