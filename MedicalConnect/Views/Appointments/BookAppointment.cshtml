@model MedicalConnect.ViewModels.BookAppointmentViewModel

@{
    ViewData["Title"] = "حجز موعد";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Main Content -->
<main class="py-5 mt-5">
    <div class="container py-4">
        <!-- Breadcrumb -->
        <nav aria-label="breadcrumb" class="mb-4">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")">الرئيسية</a></li>
                <li class="breadcrumb-item"><a href="@Url.Action("Index", "Doctors")">الأطباء</a></li>
                <li class="breadcrumb-item active" aria-current="page">حجز موعد</li>
            </ol>
        </nav>

        <h1 class="display-6 fw-bold mb-4">حجز موعد</h1>

        <div class="row g-4">
            <!-- Booking Form - Right Side -->
            <div class="col-lg-8 order-1">
                <div class="card shadow-sm rounded-4 border-0">
                    <div class="card-body p-4">
                        <div class="booking-progress mb-5">
                            <div class="row text-center position-relative">
                                <div class="col-4">
                                    <div class="booking-step active" id="step-1-indicator">
                                        <div class="booking-step-icon rounded-circle bg-primary text-white mx-auto">
                                            <i class="fas fa-calendar-day"></i>
                                        </div>
                                        <p class="mt-2 small fw-medium">اختيار الموعد</p>
                                    </div>
                                </div>
                                <div class="col-4">
                                    <div class="booking-step" id="step-2-indicator">
                                        <div class="booking-step-icon rounded-circle bg-light text-muted mx-auto">
                                            <i class="fas fa-info-circle"></i>
                                        </div>
                                        <p class="mt-2 small fw-medium">تفاصيل الحجز</p>
                                    </div>
                                </div>
                                <div class="col-4">
                                    <div class="booking-step" id="step-3-indicator">
                                        <div class="booking-step-icon rounded-circle bg-light text-muted mx-auto">
                                            <i class="fas fa-check"></i>
                                        </div>
                                        <p class="mt-2 small fw-medium">تأكيد الحجز</p>
                                    </div>
                                </div>
                                <div class="booking-progress-line"></div>
                            </div>
                        </div>

                        <form id="booking-form" asp-action="ConfirmBooking" asp-controller="Appointment" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" asp-for="DoctorId" />
                            <input type="hidden" id="selectedDate" name="SelectedDate" />
                            <input type="hidden" id="selectedTime" name="SelectedTime" />

                            <!-- Step 1: Choose Date and Time -->
                            <div id="booking-step-1" class="booking-step-content">
                                <h3 class="fs-5 fw-bold mb-4">اختر التاريخ والوقت المناسب</h3>

                                <div class="row g-4">
                                    <div class="col-md-7">
                                        <label class="form-label mb-3">اختر التاريخ</label>
                                        <div id="appointment-calendar" class="mb-4"></div>
                                    </div>

                                    <div class="col-md-5">
                                        <label class="form-label mb-3">الأوقات المتاحة</label>
                                        <div id="available-times" class="appointment-times">
                                            <div class="text-center text-muted py-4">
                                                <i class="fas fa-calendar-alt fa-2x mb-2"></i>
                                                <p>اختر التاريخ أولاً لعرض الأوقات المتاحة</p>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="mt-5 d-flex justify-content-end">
                                    <button id="goto-step-2" type="button" class="btn btn-primary px-4 py-2 rounded-3" disabled>
                                        الخطوة التالية
                                        <i class="fas fa-arrow-left ms-2"></i>
                                    </button>
                                </div>
                            </div>

                            <!-- Step 2: Booking Details -->
                            <div id="booking-step-2" class="booking-step-content d-none">
                                <h3 class="fs-5 fw-bold mb-4">تفاصيل الحجز</h3>

                                <div class="mb-4">
                                    <label class="form-label">نوع الموعد</label>
                                    <div class="row g-3">
                                        <div class="col-md-6">
                                            <div class="form-check appointment-type-card">
                                                <input class="form-check-input" type="radio" name="AppointmentType"
                                                       id="inPerson" value="inPerson" checked>
                                                <label class="form-check-label w-100 p-3 border rounded-3"
                                                       for="inPerson">
                                                    <div class="d-flex align-items-center">
                                                        <div class="rounded-circle bg-primary bg-opacity-10 p-3 me-3">
                                                            <i class="fas fa-user-md text-primary"></i>
                                                        </div>
                                                        <div>
                                                            <h6 class="mb-1">زيارة في العيادة</h6>
                                                            <p class="text-muted small mb-0">زيارة الطبيب شخصياً في العيادة</p>
                                                        </div>
                                                    </div>
                                                </label>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="form-check appointment-type-card">
                                                <input class="form-check-input" type="radio" name="AppointmentType"
                                                       id="online" value="online">
                                                <label class="form-check-label w-100 p-3 border rounded-3"
                                                       for="online">
                                                    <div class="d-flex align-items-center">
                                                        <div class="rounded-circle bg-primary bg-opacity-10 p-3 me-3">
                                                            <i class="fas fa-video text-primary"></i>
                                                        </div>
                                                        <div>
                                                            <h6 class="mb-1">استشارة عن بعد</h6>
                                                            <p class="text-muted small mb-0">استشارة عبر الفيديو مع الطبيب</p>
                                                        </div>
                                                    </div>
                                                </label>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="row g-3 mb-4">
                                    <div class="col-md-6">
                                        <label for="patientName" class="form-label">اسم المريض</label>
                                        <input type="text" class="form-control" id="patientName" value="@Model.PatientName" readonly>
                                    </div>
                                    <div class="col-md-6">
                                        <label for="patientPhone" class="form-label">رقم الهاتف</label>
                                        <input type="tel" class="form-control" id="patientPhone" value="@Model." required>
                                    </div>
                                </div>

                                <div class="mb-4">
                                    <label for="appointmentReason" class="form-label">سبب الزيارة</label>
                                    <select class="form-select" id="appointmentReason" name="Reason" required>
                                        <option value="" selected disabled>اختر سبب الزيارة</option>
                                        <option value="استشارة طبية">استشارة طبية</option>
                                        <option value="متابعة حالة">متابعة حالة</option>
                                        <option value="فحص دوري">فحص دوري</option>
                                        <option value="علاج">علاج</option>
                                        <option value="أخرى">أخرى</option>
                                    </select>
                                </div>

                                <div class="mb-4">
                                    <label for="notes" class="form-label">ملاحظات (اختياري)</label>
                                    <textarea class="form-control" id="notes" name="Notes" rows="3"
                                              placeholder="أي معلومات إضافية ترغب في إخبار الطبيب بها قبل الموعد"></textarea>
                                </div>

                                <div class="mt-5 d-flex justify-content-between">
                                    <button id="back-to-step-1" type="button"
                                            class="btn btn-outline-secondary px-4 py-2 rounded-3">
                                        <i class="fas fa-arrow-right me-2"></i>
                                        الخطوة السابقة
                                    </button>
                                    <button id="goto-step-3" type="button"
                                            class="btn btn-primary px-4 py-2 rounded-3">
                                        الخطوة التالية
                                        <i class="fas fa-arrow-left ms-2"></i>
                                    </button>
                                </div>
                            </div>

                            <!-- Step 3: Confirm Booking -->
                            <div id="booking-step-3" class="booking-step-content d-none">
                                <h3 class="fs-5 fw-bold mb-4">تأكيد الحجز</h3>

                                <div class="card bg-light border-0 rounded-4 mb-4">
                                    <div class="card-body p-4">
                                        <h4 class="fs-6 fw-semibold mb-3">تفاصيل الموعد</h4>

                                        <div class="row g-3">
                                            <div class="col-md-6">
                                                <p class="text-muted small mb-1">الطبيب</p>
                                                <p class="fw-medium" id="confirm-doctor">@Model.DoctorName</p>
                                            </div>
                                            <div class="col-md-6">
                                                <p class="text-muted small mb-1">التخصص</p>
                                                <p class="fw-medium" id="confirm-specialty">@Model.DoctorSpecialization</p>
                                            </div>
                                            <div class="col-md-6">
                                                <p class="text-muted small mb-1">التاريخ</p>
                                                <p class="fw-medium" id="confirm-date">-</p>
                                            </div>
                                            <div class="col-md-6">
                                                <p class="text-muted small mb-1">الوقت</p>
                                                <p class="fw-medium" id="confirm-time">-</p>
                                            </div>
                                            <div class="col-md-6">
                                                <p class="text-muted small mb-1">نوع الموعد</p>
                                                <p class="fw-medium" id="confirm-type">-</p>
                                            </div>
                                            <div class="col-md-6">
                                                <p class="text-muted small mb-1">سبب الزيارة</p>
                                                <p class="fw-medium" id="confirm-reason">-</p>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="card bg-light border-0 rounded-4 mb-4">
                                    <div class="card-body p-4">
                                        <h4 class="fs-6 fw-semibold mb-3">تفاصيل الدفع</h4>

                                        <div class="row mb-3">
                                            <div class="col-md-6">
                                                <p class="text-muted small mb-1">رسوم الكشف</p>
                                                <p class="fw-medium" id="confirm-fee">@Model.ConsultationFee شيكل</p>
                                            </div>
                                            <div class="col-md-6">
                                                <p class="text-muted small mb-1">طريقة الدفع</p>
                                                <div class="form-check mb-2">
                                                    <input class="form-check-input" type="radio" name="PaymentMethod"
                                                           id="creditCard" value="creditCard" checked>
                                                    <label class="form-check-label" for="creditCard">
                                                        <i class="far fa-credit-card me-2"></i>
                                                        عن طريق التطبيق / بنك فلسطين
                                                    </label>
                                                </div>
                                                <div class="form-check">
                                                    <input class="form-check-input" type="radio" name="PaymentMethod"
                                                           id="clinicPayment" value="clinicPayment">
                                                    <label class="form-check-label" for="clinicPayment">
                                                        <i class="fas fa-hand-holding-usd me-2"></i>
                                                        الدفع في العيادة
                                                    </label>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="alert alert-info d-flex align-items-center mb-0" role="alert">
                                            <i class="fas fa-info-circle me-2"></i>
                                            <div>
                                                في حالة إلغاء الموعد قبل 24 ساعة من الموعد المحدد سيتم استرداد المبلغ كاملاً.
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="form-check mb-4">
                                    <input class="form-check-input" type="checkbox" id="termsCheck" required>
                                    <label class="form-check-label" for="termsCheck">
                                        أوافق على <a href="#" class="text-decoration-none">الشروط والأحكام</a> و<a href="#" class="text-decoration-none">سياسة الخصوصية</a>
                                    </label>
                                </div>

                                <div class="mt-5 d-flex justify-content-between">
                                    <button id="back-to-step-2" type="button"
                                            class="btn btn-outline-secondary px-4 py-2 rounded-3">
                                        <i class="fas fa-arrow-right me-2"></i>
                                        الخطوة السابقة
                                    </button>
                                    <button id="confirm-booking" type="button"
                                            class="btn btn-primary px-4 py-2 rounded-3">
                                        <span id="booking-spinner" class="spinner-border spinner-border-sm d-none me-2" role="status"></span>
                                        تأكيد الحجز والدفع
                                        <i class="fas fa-check ms-2"></i>
                                    </button>
                                </div>
                            </div>
                        </form>

                        <!-- Step 4: Booking Confirmed -->
                        <div id="booking-step-4" class="booking-step-content d-none text-center py-4">
                            <div class="success-animation mb-4">
                                <div class="checkmark-circle">
                                    <div class="background"></div>
                                    <div class="checkmark draw"></div>
                                </div>
                            </div>

                            <h3 class="fs-5 fw-bold mb-3">تم تأكيد الحجز بنجاح!</h3>
                            <p class="text-muted mb-4">تم حجز موعدك بنجاح مع @Model.DoctorName</p>

                            <div class="card bg-light border-0 rounded-4 mb-5 text-start mx-auto"
                                 style="max-width: 450px;">
                                <div class="card-body p-4">
                                    <div class="row g-3">
                                        <div class="col-6">
                                            <p class="text-muted small mb-1">رقم الحجز</p>
                                            <p class="fw-medium" id="booking-number">-</p>
                                        </div>
                                        <div class="col-6">
                                            <p class="text-muted small mb-1">التاريخ</p>
                                            <p class="fw-medium" id="booking-date">-</p>
                                        </div>
                                        <div class="col-6">
                                            <p class="text-muted small mb-1">الوقت</p>
                                            <p class="fw-medium" id="booking-time">-</p>
                                        </div>
                                        <div class="col-6">
                                            <p class="text-muted small mb-1">نوع الموعد</p>
                                            <p class="fw-medium" id="booking-type">-</p>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="d-flex flex-column flex-sm-row gap-3 justify-content-center">
                                <a href="@Url.Action("MyAppointments", "Appointment")" class="btn btn-outline-primary px-4 py-2 rounded-3">
                                    <i class="fas fa-calendar-check me-2"></i>
                                    عرض مواعيدي
                                </a>
                                <a href="@Url.Action("Profile", "Patients")" class="btn btn-primary px-4 py-2 rounded-3">
                                    <i class="fas fa-home me-2"></i>
                                    العودة إلى الملف الشخصي
                                </a>
                                <a href="@Url.Action("Index", "Home")" class="btn btn-primary px-4 py-2 rounded-3">
                                    <i class="fas fa-home me-2"></i>
                                    العودة إلى الرئيسية
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Doctor Info - Left Side -->
            <div class="col-lg-4 order-2">
                <div class="card shadow-sm rounded-4 border-0 sticky-lg-top" style="top: 100px;">
                    <div class="card-body p-4">
                        <h3 class="fs-5 fw-bold mb-3">معلومات الطبيب</h3>

                        <div class="d-flex mb-4">
                            <div class="rounded-circle bg-light overflow-hidden me-3"
                                 style="width: 60px; height: 60px;">
                                <img id="doctor-image" src="@Model.DoctorImageUrl" alt="صورة الطبيب" class="w-100 h-100 object-fit-cover">
                            </div>
                            <div>
                                <h4 id="doctor-name" class="fs-6 fw-semibold mb-1">@Model.DoctorName</h4>
                                <p id="doctor-specialty" class="text-medical-600 mb-1">@Model.DoctorSpecialization</p>
                                <div class="d-flex align-items-center">
                                    <i class="fas fa-star text-warning me-1"></i>
                                    <span id="doctor-rating" class="fw-medium me-1">@((Model.Doctor.Rating ?? 0).ToString("F1"))</span>
                                    <span class="text-muted small">(<span id="doctor-reviews">@Model.Doctor.RatingCount</span> تقييم)</span>
                                </div>
                            </div>
                        </div>

                        <hr class="my-3">

                        <div class="d-flex align-items-center mb-3">
                            <div class="me-3">
                                <i class="fas fa-map-marker-alt text-medical-600"></i>
                            </div>
                            <div>
                                <p class="text-muted small mb-1">العنوان</p>
                                <p id="doctor-location" class="mb-0">@Model.Doctor.Workplace</p>
                            </div>
                        </div>

                        <div class="d-flex align-items-center mb-3">
                            <div class="me-3">
                                <i class="fas fa-comment-medical text-medical-600"></i>
                            </div>
                            <div>
                                <p class="text-muted small mb-1">رسوم الكشف</p>
                                <p id="doctor-fee" class="mb-0">@Model.ConsultationFee شيكل</p>
                            </div>
                        </div>

                        <div class="d-flex align-items-center">
                            <div class="me-3">
                                <i class="fas fa-hourglass-half text-medical-600"></i>
                            </div>
                            <div>
                                <p class="text-muted small mb-1">مدة الكشف</p>
                                <p id="doctor-session-duration" class="mb-0">@Model.Doctor.WorkingHours دقيقة</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</main>

<!-- Toast Container -->
<div class="toast-container position-fixed bottom-0 end-0 p-3"></div>

@section Scripts {
    <script>
        // متغيرات JavaScript مطلوبة
        const doctorId = @Model.DoctorId;
        const availableDates = @Html.Raw(Json.Serialize(Model.AvailableDates.Select(d => d.ToString("yyyy-MM-dd"))));
    </script>

    <script>
        // متغيرات عامة
        let currentStep = 1;
        let selectedDate = null;
        let selectedTime = null;

        // عند تحميل الصفحة
        document.addEventListener('DOMContentLoaded', function() {
            initCalendar();
            initStepNavigation();
        });

        // تهيئة التقويم
        function initCalendar() {
            const calendarDiv = document.getElementById('appointment-calendar');
            if (!calendarDiv) return;

            const today = new Date();
            const currentMonth = today.getMonth();
            const currentYear = today.getFullYear();

            // إنشاء التقويم
            let calendarHTML = '<div class="calendar-container">';

            // رأس التقويم
            calendarHTML += `
                <div class="calendar-header d-flex justify-content-between align-items-center mb-3">
                    <button type="button" class="btn btn-sm btn-outline-primary" id="prev-month">
                        <i class="fas fa-chevron-right"></i>
                    </button>
                    <h5 class="mb-0" id="calendar-month-year"></h5>
                    <button type="button" class="btn btn-sm btn-outline-primary" id="next-month">
                        <i class="fas fa-chevron-left"></i>
                    </button>
                </div>
            `;

            // أيام الأسبوع
            calendarHTML += `
                <div class="calendar-days-header row g-1 text-center mb-2">
                    <div class="col fw-bold text-muted small">الأحد</div>
                    <div class="col fw-bold text-muted small">الاثنين</div>
                    <div class="col fw-bold text-muted small">الثلاثاء</div>
                    <div class="col fw-bold text-muted small">الأربعاء</div>
                    <div class="col fw-bold text-muted small">الخميس</div>
                    <div class="col fw-bold text-muted small">الجمعة</div>
                    <div class="col fw-bold text-muted small">السبت</div>
                </div>
            `;

            // أيام الشهر
            calendarHTML += '<div class="calendar-days" id="calendar-days"></div>';
            calendarHTML += '</div>';

            calendarDiv.innerHTML = calendarHTML;

            // رسم الشهر الحالي
            drawMonth(currentYear, currentMonth);

            // أحداث الأزرار
            document.getElementById('prev-month').addEventListener('click', function() {
                const [year, month] = getCurrentMonthYear();
                const newDate = new Date(year, month - 1, 1);
                drawMonth(newDate.getFullYear(), newDate.getMonth());
            });

            document.getElementById('next-month').addEventListener('click', function() {
                const [year, month] = getCurrentMonthYear();
                const newDate = new Date(year, month + 1, 1);
                drawMonth(newDate.getFullYear(), newDate.getMonth());
            });
        }

        // رسم أيام الشهر
        function drawMonth(year, month) {
            const calendarDays = document.getElementById('calendar-days');
            const monthYearLabel = document.getElementById('calendar-month-year');

            const monthNames = ['يناير', 'فبراير', 'مارس', 'أبريل', 'مايو', 'يونيو',
                               'يوليو', 'أغسطس', 'سبتمبر', 'أكتوبر', 'نوفمبر', 'ديسمبر'];

            monthYearLabel.textContent = `${monthNames[month]} ${year}`;

            const firstDay = new Date(year, month, 1).getDay();
            const daysInMonth = new Date(year, month + 1, 0).getDate();
            const today = new Date();
            today.setHours(0, 0, 0, 0);

            let daysHTML = '<div class="row g-1">';

            // خلايا فارغة قبل أول يوم
            for (let i = 0; i < firstDay; i++) {
                daysHTML += '<div class="col"></div>';
            }

            // أيام الشهر
            for (let day = 1; day <= daysInMonth; day++) {
                const currentDate = new Date(year, month, day);
                const dateStr = formatDate(currentDate);
                const isPast = currentDate < today;

                let dayClass = 'calendar-day p-2 text-center rounded';

                if (isPast) {
                    dayClass += ' disabled text-muted';
                } else {
                    dayClass += ' available';
                }

                if (selectedDate === dateStr) {
                    dayClass += ' selected';
                }

                daysHTML += `
                    <div class="col">
                        <div class="${dayClass}" data-date="${dateStr}" ${isPast ? '' : `onclick="selectDate('${dateStr}')"`}>
                            ${day}
                        </div>
                    </div>
                `;
            }

            daysHTML += '</div>';
            calendarDays.innerHTML = daysHTML;
        }

        // اختيار تاريخ
        window.selectDate = function(dateStr) {
            selectedDate = dateStr;

            // تحديث التقويم
            document.querySelectorAll('.calendar-day').forEach(day => {
                day.classList.remove('selected');
            });
            document.querySelector(`[data-date="${dateStr}"]`).classList.add('selected');

            // عرض الأوقات المتاحة
            displayAvailableTimes();

            // تفعيل زر الخطوة التالية
            if (selectedTime) {
                document.getElementById('goto-step-2').disabled = false;
            }
        }

        // عرض الأوقات المتاحة
        function displayAvailableTimes() {
            const timesDiv = document.getElementById('available-times');

            // أوقات افتراضية (صباحية ومسائية)
            const morningTimes = ['9:00', '9:30', '10:00', '10:30', '11:00', '11:30'];
            const eveningTimes = ['1:00', '1:30', '2:00', '2:30', '3:00', '3:30'];

            let timesHTML = '<div class="times-list">';

            // أوقات الصباح
            timesHTML += '<h6 class="text-muted small mb-2">صباحاً</h6>';
            timesHTML += '<div class="row g-2 mb-3">';
            morningTimes.forEach(time => {
                const timeClass = selectedTime === time ? 'time-slot selected' : 'time-slot';
                timesHTML += `
                    <div class="col-6">
                        <div class="${timeClass}" onclick="selectTime('${time}')">
                            ${time}
                        </div>
                    </div>
                `;
            });
            timesHTML += '</div>';

            // أوقات المساء
            timesHTML += '<h6 class="text-muted small mb-2">مساءً</h6>';
            timesHTML += '<div class="row g-2">';
            eveningTimes.forEach(time => {
                const timeClass = selectedTime === time ? 'time-slot selected' : 'time-slot';
                timesHTML += `
                    <div class="col-6">
                        <div class="${timeClass}" onclick="selectTime('${time}')">
                            ${time}
                        </div>
                    </div>
                `;
            });
            timesHTML += '</div>';

            timesHTML += '</div>';
            timesDiv.innerHTML = timesHTML;
        }

        // اختيار وقت
        window.selectTime = function(time) {
            selectedTime = time;

            // تحديث الأوقات
            document.querySelectorAll('.time-slot').forEach(slot => {
                slot.classList.remove('selected');
            });
            event.target.classList.add('selected');

            // تفعيل زر الخطوة التالية
            if (selectedDate && selectedTime) {
                document.getElementById('goto-step-2').disabled = false;
            }
        }

        // تهيئة التنقل بين الخطوات
        function initStepNavigation() {
            // الانتقال إلى الخطوة 2
            document.getElementById('goto-step-2').addEventListener('click', function() {
                if (selectedDate && selectedTime) {
                    goToStep(2);
                }
            });

            // العودة إلى الخطوة 1
            document.getElementById('back-to-step-1').addEventListener('click', function() {
                goToStep(1);
            });

            // الانتقال إلى الخطوة 3
            document.getElementById('goto-step-3').addEventListener('click', function() {
                if (validateStep2()) {
                    updateConfirmationDetails();
                    goToStep(3);
                }
            });

            // العودة إلى الخطوة 2
            document.getElementById('back-to-step-2').addEventListener('click', function() {
                goToStep(2);
            });

            // تأكيد الحجز
            document.getElementById('confirm-booking').addEventListener('click', function() {
                confirmBooking();
            });
        }

        // الانتقال إلى خطوة معينة
        function goToStep(step) {
            // إخفاء جميع الخطوات
            document.querySelectorAll('.booking-step-content').forEach(content => {
                content.classList.add('d-none');
            });

            // عرض الخطوة المطلوبة
            document.getElementById(`booking-step-${step}`).classList.remove('d-none');

            // تحديث مؤشرات الخطوات
            for (let i = 1; i <= 3; i++) {
                const indicator = document.getElementById(`step-${i}-indicator`);
                const icon = indicator.querySelector('.booking-step-icon');

                if (i <= step) {
                    indicator.classList.add('active');
                    icon.classList.remove('bg-light', 'text-muted');
                    icon.classList.add('bg-primary', 'text-white');
                } else {
                    indicator.classList.remove('active');
                    icon.classList.remove('bg-primary', 'text-white');
                    icon.classList.add('bg-light', 'text-muted');
                }
            }

            currentStep = step;
        }

        // التحقق من صحة الخطوة 2
        function validateStep2() {
            const reason = document.getElementById('appointmentReason').value;

            if (!reason) {
                showToast('error', 'يرجى اختيار سبب الزيارة');
                return false;
            }

            return true;
        }

        // تحديث تفاصيل التأكيد
        function updateConfirmationDetails() {
            const appointmentType = document.querySelector('input[name="AppointmentType"]:checked').value;
            const reason = document.getElementById('appointmentReason').value;

            // تحديث التاريخ
            const date = new Date(selectedDate);
            const formattedDate = date.toLocaleDateString('ar-EG', {
                weekday: 'long',
                year: 'numeric',
                month: 'long',
                day: 'numeric'
            });
            document.getElementById('confirm-date').textContent = formattedDate;

            // تحديث الوقت
            document.getElementById('confirm-time').textContent = selectedTime;

            // تحديث نوع الموعد
            const typeText = appointmentType === 'inPerson' ? 'زيارة في العيادة' : 'استشارة عن بعد';
            document.getElementById('confirm-type').textContent = typeText;

            // تحديث سبب الزيارة
            document.getElementById('confirm-reason').textContent = reason;
        }

        // تأكيد الحجز
        async function confirmBooking() {
            const termsCheck = document.getElementById('termsCheck');

            if (!termsCheck.checked) {
                showToast('error', 'يجب الموافقة على الشروط والأحكام');
                return;
            }

            const bookingButton = document.getElementById('confirm-booking');
            const spinner = document.getElementById('booking-spinner');

            bookingButton.disabled = true;
            spinner.classList.remove('d-none');

            // محاكاة عملية الحجز
            setTimeout(() => {
                // إخفاء الخطوة 3 وعرض الخطوة 4
                document.getElementById('booking-step-3').classList.add('d-none');
                document.getElementById('booking-step-4').classList.remove('d-none');

                // تحديث تفاصيل الحجز النهائية
                const bookingNumber = 'BK-' + Math.floor(100000 + Math.random() * 900000);
                document.getElementById('booking-number').textContent = bookingNumber;

                const date = new Date(selectedDate);
                const formattedDate = date.toLocaleDateString('ar-EG', {
                    day: 'numeric',
                    month: 'long',
                    year: 'numeric'
                });
                document.getElementById('booking-date').textContent = formattedDate;
                document.getElementById('booking-time').textContent = selectedTime;

                const appointmentType = document.querySelector('input[name="AppointmentType"]:checked').value;
                const typeText = appointmentType === 'inPerson' ? 'زيارة في العيادة' : 'استشارة عن بعد';
                document.getElementById('booking-type').textContent = typeText;

                bookingButton.disabled = false;
                spinner.classList.add('d-none');

                showToast('success', 'تم تأكيد الحجز بنجاح!');
            }, 2000);
        }

        // دوال مساعدة
        function formatDate(date) {
            const year = date.getFullYear();
            const month = String(date.getMonth() + 1).padStart(2, '0');
            const day = String(date.getDate()).padStart(2, '0');
            return `${year}-${month}-${day}`;
        }

        function getCurrentMonthYear() {
            const label = document.getElementById('calendar-month-year').textContent;
            const monthNames = ['يناير', 'فبراير', 'مارس', 'أبريل', 'مايو', 'يونيو',
                               'يوليو', 'أغسطس', 'سبتمبر', 'أكتوبر', 'نوفمبر', 'ديسمبر'];
            const parts = label.split(' ');
            const month = monthNames.indexOf(parts[0]);
            const year = parseInt(parts[1]);
            return [year, month];
        }

        function showToast(type, message) {
            const toastHTML = `
                <div class="toast align-items-center text-white bg-${type === 'success' ? 'success' : 'danger'} border-0" role="alert">
                    <div class="d-flex">
                        <div class="toast-body">
                            ${message}
                        </div>
                        <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
                    </div>
                </div>
            `;

            const container = document.querySelector('.toast-container');
            container.innerHTML = toastHTML;

            const toastElement = container.querySelector('.toast');
            const toast = new bootstrap.Toast(toastElement);
            toast.show();
        }
    </script>
    @* <script src="~/js/book-appointment.js"></script> *@
}