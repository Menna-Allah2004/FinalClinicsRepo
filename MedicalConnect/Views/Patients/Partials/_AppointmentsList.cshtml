@model IEnumerable<MedicalConnect.ViewModels.AppointmentViewModel>

@foreach (var appointment in Model)
{
    <div class="card mb-3 border-0 shadow-sm hover-card">
        <div class="card-body p-3">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <h5 class="card-title h6 fw-bold mb-1">@appointment.DoctorName</h5>
                    <p class="text-muted small mb-2">@appointment.DoctorSpecialization</p>
                </div>
                <span class="badge bg-@(appointment.Status == "مكتمل" ? "success" : appointment.Status == "ملغي" ? "danger" : "primary") bg-opacity-10 text-@(appointment.Status == "مكتمل" ? "success" : appointment.Status == "ملغي" ? "danger" : "primary") px-3 py-2 rounded-pill">
                    <i class="fas fa-@(appointment.Status == "مكتمل" ? "check-circle" : appointment.Status == "ملغي" ? "times-circle" : "clock") me-1"></i>
                    @appointment.Status
                </span>
            </div>

            <div class="d-flex align-items-center text-muted small mb-3">
                <i class="fas fa-calendar-day me-2"></i>
                <span class="me-3">@appointment.AppointmentTime.ToString("dd/MM/yyyy")</span>
                <i class="fas fa-clock me-2"></i>
                <span>@appointment.AppointmentTime.ToString("HH:mm")</span>
            </div>

            @if (!string.IsNullOrEmpty(appointment.Notes))
            {
                <p class="mb-3 small">@appointment.Notes</p>
            }
        </div>
    </div>
}