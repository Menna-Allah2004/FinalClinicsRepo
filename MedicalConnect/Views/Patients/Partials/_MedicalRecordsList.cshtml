@model IEnumerable<MedicalConnect.ViewModels.MedicalReportViewModel>

@foreach (var record in Model)
{
    <div class="card mb-3 border-0 shadow-sm hover-card">
        <div class="card-body p-3">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <h5 class="card-title h6 fw-bold mb-1">@record.Title</h5>
                    <p class="text-muted small mb-2">@record.DoctorName</p>
                </div>
                <span class="text-muted small">@record.CreatedAt.ToString("dd/MM/yyyy")</span>
            </div>

            @if (!string.IsNullOrEmpty(record.Diagnosis))
            {
                <p class="mb-3">@record.Diagnosis</p>
            }

            @if (!string.IsNullOrEmpty(record.Treatment))
            {
                <p class="mb-3"><strong>العلاج:</strong> @record.Treatment</p>
            }
        </div>
    </div>
}